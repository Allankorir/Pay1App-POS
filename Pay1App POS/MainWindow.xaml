<Window x:Class="Pay1App_POS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pay1App_POS"
        mc:Ignorable="d"
        Title="Pay1App POS"
Width="1920"
Height="1080"
WindowState="Maximized"
WindowStartupLocation="CenterScreen"
Background="#F5F6FA"
FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Bordered triangle used at the bottom of nav buttons -->
        <Style x:Key="ToolbarCaret" TargetType="Path">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,-2"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="#9CA3AF"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Data" Value="M 0,0 L 12,0 L 6,7 Z"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Left nav buttons: icon + label + bordered triangle -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="3,8"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="12,8,12,6">
                            <StackPanel HorizontalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center"/>
                                <Path Style="{StaticResource ToolbarCaret}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8EAF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PayButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16A34A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FnButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,8,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryTile" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductCard" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="8">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                    <Setter Property="Background" Value="#F5F3FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE721;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Search"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE77B;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Customer"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8AB;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Transfer"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8C9;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Discount"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8BD;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Comment"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE710;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="New sale"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7A7;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Refund"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE77B;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="John"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7BF;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Cash drawer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FnButton}" Content="F9  Save sale"/>
                    <Button Style="{StaticResource PayButton}" Content="F10  Payment" Margin="0,0,8,0"
                            Command="{Binding CheckoutCommand}"/>
                    <Button Style="{StaticResource PayButton}" Content="F12  Cash"
                            Background="#16A34A" Command="{Binding CheckoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✕ Delete" Foreground="#DC2626" Background="Transparent"
                                        BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                                        Command="{Binding ClearCartCommand}"/>
                                <TextBlock Text="   Quantity" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#6B7280"/>
                            </StackPanel>
                            <TextBlock Text="John" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#374151"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" CornerRadius="8" Margin="0,0,0,6" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold"
                                                           FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Foreground="#6B7280" FontSize="12" Margin="0,2,0,0">
                                                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                    <Run Text=" × "/>
                                                    <Run Text="{Binding UnitPrice, StringFormat={}{0:N2}, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="−" Width="28" Height="28" FontSize="14"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Quantity}" Width="24" TextAlignment="Center"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <Button Content="+" Width="28" Height="28" FontSize="14"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Margin="4,0,4,0"/>
                                                <Button Content="✕" Width="28" Height="28" Foreground="#DC2626"
                                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,4">
                                <TextBlock Text="Subtotal" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding SubTotal, StringFormat={}{0:N2}}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Tax" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding Tax, StringFormat={}{0:N2}}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="Total" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Total, StringFormat={}{0:N2}}"
                                           FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Right" Foreground="#7C3AED"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="10,0" FontSize="16"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" FontSize="15" VerticalContentAlignment="Center"
                                 Padding="0,10"/>
                        <Button Grid.Column="2" Content="Search" Style="{StaticResource ToolbarButton}"
                                Command="{Binding SearchCommand}" Margin="0,0,6,0"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Button Style="{StaticResource CategoryTile}" Background="#3B82F6" Height="70" Margin="0,0,8,0"
                                    Content="Wine" Command="{Binding FilterCategoryCommand}" CommandParameter="Wine"/>
                            <Button Style="{StaticResource CategoryTile}" Background="#8B5CF6" Height="70" Margin="0,0,8,0"
                                    Content="Spirits" Command="{Binding FilterCategoryCommand}" CommandParameter="Spirit"/>
                            <Button Style="{StaticResource CategoryTile}" Background="#F59E0B" Height="70" Margin="0,0,8,0"
                                    Content="Beer" Command="{Binding FilterCategoryCommand}" CommandParameter="Beer"/>
                            <Button Style="{StaticResource CategoryTile}" Background="#10B981" Height="70"
                                    Content="All" Command="{Binding FilterCategoryCommand}" CommandParameter=""/>
                        </UniformGrid>

                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProductCard}" Margin="0,0,12,12" Height="160"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Background="#F3F4F6" CornerRadius="8" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Category}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#9CA3AF" FontSize="13"/>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Price, StringFormat={}{0:N2}}"
                                                       FontWeight="Bold" FontSize="15"
                                                       Foreground="#7C3AED" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- BOTTOM BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Void order" Background="#DC2626" Foreground="White"
                            FontWeight="SemiBold" Padding="16,10" BorderThickness="0" Cursor="Hand"
                            Command="{Binding ClearCartCommand}"/>
                    <Button Content="Lock" Margin="12,0,0,0" Padding="16,10"
                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Repeat round" Margin="12,0,0,0" Padding="16,10"
                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="#6B7280" FontSize="13"/>
            </Grid>
        </Border>
    </Grid>
</Window>